# Server-only Gemini key. Without it Rusdi serves verified facts and FAQ.
GEMINI_API_KEY=
# Set to a generation model available in your Gemini account; no hardcoded model fallback.
GEMINI_GENERATION_MODEL=
RUSDI_GENERATION_MODEL=
RUSDI_EMBEDDING_MODEL=gemini-embedding-001
RUSDI_EMBEDDING_DIMENSIONS=768
RUSDI_ENABLED=true

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Separate browser and server keys. Never prefix a server secret with VITE_.
# Server: enable Places API (New), optionally Geocoding API for area lookup.
GOOGLE_PLACES_SERVER_KEY=
# Browser: enable Maps JavaScript API and restrict to your site's referrers.
VITE_GOOGLE_MAPS_BROWSER_KEY=
VITE_GOOGLE_MAP_ID=

# Docker PostgreSQL. Change both passwords and the matching connection URLs.
POSTGRES_PASSWORD=CHANGE_ADMIN_PASSWORD
RUSDI_DB_PASSWORD=CHANGE_RUNTIME_PASSWORD
RUSDI_DB_PORT=15432
DATABASE_MIGRATION_URL=postgresql://kindo_admin:CHANGE_ADMIN_PASSWORD@127.0.0.1:15432/kindo_knowledge
DATABASE_URL=postgresql://rusdi_runtime:CHANGE_RUNTIME_PASSWORD@127.0.0.1:15432/kindo_knowledge

# Optional: defaults to firebase-applet-config.json projectId.
FIREBASE_PROJECT_ID=
PORT=3000
